{
  "name": "oneskill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first Agent capability workspace",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "oneskill": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs serve --open",
    "web": "node src/cli.mjs serve --open",
    "dev": "node src/cli.mjs serve",
    "dev:web": "npm --prefix web run dev",
    "demo": "node scripts/demo.mjs",
    "build": "npm --prefix web run build",
    "cli": "node src/cli.mjs",
    "check": "node --check src/core.mjs && node --check src/agent-discovery.mjs && node --check src/agent-catalog.mjs && node --check src/configuration.mjs && node --check src/migration.mjs && node --check src/server.mjs && node --check src/cli.mjs && npm test && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0"
  }
}
